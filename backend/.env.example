# HishabAI Backend — Environment Variables
# Copy this file to .env and fill in real values

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://qlrqbqisavkfxywkiuca.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct DB (for SQLAlchemy complex queries)
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db.qlrqbqisavkfxywkiuca.supabase.co:5432/postgres

# ── Redis (for Celery) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Vertex AI (Gemini) ───────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.5-flash

# ── Email ─────────────────────────────────────────────────────────────────
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@hishabai.com

# ── App ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Feature Flags ─────────────────────────────────────────────────────────
FEATURE_MIS_REPORTS=true

# ── Supabase Storage ──────────────────────────────────────────────────────
STORAGE_BUCKET=documents
