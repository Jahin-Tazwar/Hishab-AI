# backend/.env.example — copy to .env and fill in real values

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://qlrqbqisavkfxywkiuca.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
MAX_UPLOAD_SIZE_MB=20

# ── Storage ───────────────────────────────────────────────────────────────
STORAGE_BUCKET=documents

# ── Production deploy ─────────────────────────────────────────────────────
# Comma-separated production origins (frontend URL after deploy).
# Empty in dev — only used when running on Render.
FRONTEND_ORIGIN=
